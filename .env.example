# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# Telegram bot token. Get it from @BotFather in Telegram.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# OpenWeatherMap API key. Free tier is enough: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key

# Optional. Paths are relative to the project directory.
DB_PATH=data/weather_bot.db
LOG_PATH=logs/bot.log

# Optional. Your Telegram user id, for admin commands.
ADMIN_ID=

# Optional. Timezone used for the daily broadcast schedule.
TIMEZONE=Europe/Moscow